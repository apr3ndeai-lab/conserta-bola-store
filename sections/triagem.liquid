{% liquid
  assign heading_text = section.settings.heading | default: 'Qual o problema da sua bola?'
  assign lede_text = section.settings.lede
%}

<section class="triagem" aria-labelledby="triagem-title" style="--triagem-bg: {{ section.settings.bg_color }}; --triagem-card-bg: {{ section.settings.card_bg_color }};">
  <div class="triagem__intro">
    <h2 id="triagem-title">{{ heading_text }}</h2>
    {% if lede_text != blank %}
      <p class="triagem__lede">{{ lede_text }}</p>
    {% endif %}
  </div>

  <ul class="triagem__list" role="list">
    {% for block in section.blocks %}
      {% if block.type == 'card' %}
        {% liquid
          assign has_secondary = false
          if block.settings.href_secondary != blank and block.settings.label_secondary != blank
            assign has_secondary = true
          endif
          assign primary_label = block.settings.label_primary | default: block.settings.next_label | default: 'Ver próximo passo'
          assign card_title_id = 'triagem-card-title-' | append: block.id
        %}
        <li {{ block.shopify_attributes }}>
          <article
            class="triagem-card{% if block.settings.is_fallback %} triagem-card--fallback{% endif %}"
            aria-labelledby="{{ card_title_id }}"
          >
            <h3 id="{{ card_title_id }}" class="triagem-card__title">{{ block.settings.title }}</h3>
            <p class="triagem-card__desc">{{ block.settings.description }}</p>
            <div class="triagem-card__ctas{% if has_secondary %} triagem-card__ctas--dual{% endif %}">
              <a
                class="cta cta--primary"
                href="{{ block.settings.href }}"
                {% if block.settings.href contains 'wa.me' or block.settings.href contains 'http' %}target="_blank" rel="noopener"{% endif %}
                data-track="triagem_select"
                data-triagem-opcao="{{ block.settings.opcao }}"
                data-triagem-cta="{{ block.settings.cta_primary_kind | default: 'buy' }}"
              >{{ primary_label }}</a>
              {% if has_secondary %}
                <a
                  class="cta cta--secondary"
                  href="{{ block.settings.href_secondary }}"
                  {% if block.settings.href_secondary contains 'wa.me' or block.settings.href_secondary contains 'http' %}target="_blank" rel="noopener"{% endif %}
                  {% if block.settings.aria_secondary != blank %}aria-label="{{ block.settings.aria_secondary | escape }}"{% endif %}
                  data-track="triagem_select"
                  data-triagem-opcao="{{ block.settings.opcao }}"
                  data-triagem-cta="{{ block.settings.cta_secondary_kind | default: 'whatsapp' }}"
                >{{ block.settings.label_secondary }}</a>
              {% endif %}
            </div>
          </article>
        </li>
      {% endif %}
    {% endfor %}
  </ul>

  {% if section.settings.cta_href != blank %}
    <div class="triagem__cta-wrap">
      {% if section.settings.cta_lede != blank %}
        <p class="triagem__cta-lede">{{ section.settings.cta_lede }}</p>
      {% endif %}
      <a class="button button--primary" href="{{ section.settings.cta_href }}" {% if section.settings.cta_href contains 'wa.me' or section.settings.cta_href contains 'http' %}target="_blank" rel="noopener"{% endif %} data-track="triagem_cta_avaliacao">
        {{ section.settings.cta_label | default: 'Quero avaliar minha bola' }}
      </a>
    </div>
  {% endif %}
</section>

{% stylesheet %}
  .triagem {
    background-color: var(--triagem-bg, transparent);
    padding-block: 48px;
    padding-inline: 24px;
    max-width: var(--page-width, 1200px);
    margin-inline: auto;
    --triagem-gold: #E8B84B;
    --triagem-gold-hover: #F1C766;
    --triagem-gold-ink: #0D1526;
    --triagem-focus-ring: #7CC4FF;
    --triagem-radius: 8px;
    --triagem-touch-min: 44px;
  }

  .triagem__intro {
    text-align: center;
    max-width: 640px;
    margin-inline: auto;
    margin-block-end: 32px;
  }

  .triagem__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  @media screen and (min-width: 750px) {
    .triagem__list {
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
  }

  .triagem-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: 24px;
    border: 1px solid rgba(248, 250, 252, 0.08);
    border-radius: var(--triagem-radius);
    background-color: var(--triagem-card-bg, transparent);
    color: inherit;
  }

  .triagem-card__title {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .triagem-card__desc {
    margin: 0;
    flex-grow: 1;
  }

  .triagem-card__ctas {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-block-start: 8px;
  }

  @media screen and (min-width: 750px) {
    .triagem-card__ctas--dual {
      flex-direction: row;
      align-items: stretch;
    }
    .triagem-card__ctas--dual .cta--primary {
      flex: 2 1 0;
    }
    .triagem-card__ctas--dual .cta--secondary {
      flex: 1 1 0;
    }
  }

  .triagem .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--triagem-touch-min);
    padding: 12px 16px;
    border-radius: var(--triagem-radius);
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    transition: background-color 120ms ease, color 120ms ease, transform 80ms ease;
  }

  .triagem .cta--primary {
    background: var(--triagem-gold);
    color: var(--triagem-gold-ink);
    border: 1px solid var(--triagem-gold);
  }

  .triagem .cta--primary:hover { background: var(--triagem-gold-hover); }
  .triagem .cta--primary:active { transform: translateY(1px); }

  .triagem .cta--secondary {
    background: transparent;
    color: var(--triagem-gold);
    border: 1px solid var(--triagem-gold);
  }

  .triagem .cta--secondary:hover { background: rgba(232, 184, 75, 0.08); }
  .triagem .cta--secondary:active { transform: translateY(1px); }

  .triagem .cta:focus-visible {
    outline: 2px solid var(--triagem-focus-ring);
    outline-offset: 3px;
  }

  .triagem__cta-wrap {
    text-align: center;
    margin-block-start: 32px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .triagem__cta-wrap .button {
    margin-inline: auto !important;
    width: fit-content !important;
    align-self: center;
    display: inline-flex;
  }
{% endstylesheet %}

