{% assign block_settings = block.settings %}

<ul class="cb-trust-badges" {{ block.shopify_attributes }}>
  {% if block_settings.show_shipping %}
    <li class="cb-trust-badges__item">
      <span class="cb-trust-badges__icon" aria-hidden="true">🚚</span>
      <span class="cb-trust-badges__label">{{ block_settings.shipping_label }}</span>
    </li>
  {% endif %}
  {% if block_settings.show_guarantee %}
    <li class="cb-trust-badges__item">
      <span class="cb-trust-badges__icon" aria-hidden="true">🛡️</span>
      <span class="cb-trust-badges__label">{{ block_settings.guarantee_label }}</span>
    </li>
  {% endif %}
  {% if block_settings.show_payment %}
    <li class="cb-trust-badges__item">
      <span class="cb-trust-badges__icon" aria-hidden="true">💳</span>
      <span class="cb-trust-badges__label">{{ block_settings.payment_label }}</span>
    </li>
  {% endif %}
</ul>

{% stylesheet %}
  .cb-trust-badges {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 20px;
    font-size: 0.875rem;
    line-height: 1.3;
  }
  .cb-trust-badges__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .cb-trust-badges__icon {
    font-size: 1.1rem;
  }
  @media (max-width: 640px) {
    .cb-trust-badges {
      gap: 8px 14px;
      font-size: 0.8125rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Trust badges",
  "tag": null,
  "settings": [
    {
      "type": "checkbox",
      "id": "show_shipping",
      "label": "Mostrar frete",
      "default": true
    },
    {
      "type": "text",
      "id": "shipping_label",
      "label": "Texto de frete",
      "default": "Envio em até 24h úteis"
    },
    {
      "type": "checkbox",
      "id": "show_guarantee",
      "label": "Mostrar garantia",
      "default": true
    },
    {
      "type": "text",
      "id": "guarantee_label",
      "label": "Texto de garantia",
      "default": "Satisfação garantida"
    },
    {
      "type": "checkbox",
      "id": "show_payment",
      "label": "Mostrar pagamento",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_label",
      "label": "Texto de pagamento",
      "default": "Pix, cartão e boleto"
    }
  ],
  "presets": [
    {
      "name": "Trust badges"
    }
  ]
}
{% endschema %}
