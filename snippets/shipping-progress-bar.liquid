{% doc %}
  Barra de progresso de frete grátis para o cart drawer / cart page.
  Threshold em centavos (R$ 299,00 = 29900). Ajuste em cb_ship_threshold.
{% enddoc %}

{%- liquid
  assign cb_ship_threshold = 29900
  assign cb_cart_total = cart.total_price | default: 0
  assign cb_remaining = cb_ship_threshold | minus: cb_cart_total
  if cb_remaining < 0
    assign cb_remaining = 0
  endif
  assign cb_percent = 0
  if cb_cart_total > 0
    assign cb_percent = cb_cart_total | times: 100 | divided_by: cb_ship_threshold
    if cb_percent > 100
      assign cb_percent = 100
    endif
  endif
-%}

{%- unless cart.empty? -%}
  <div class="cb-ship-progress" role="status" aria-live="polite">
    <p class="cb-ship-progress__label">
      {%- if cb_remaining == 0 -%}
        🎉 Você ganhou <strong>frete grátis</strong>!
      {%- else -%}
        Faltam <strong>{{ cb_remaining | money }}</strong> para ganhar frete grátis
      {%- endif -%}
    </p>
    <div class="cb-ship-progress__track" aria-hidden="true">
      <div class="cb-ship-progress__fill" style="width: {{ cb_percent }}%;"></div>
    </div>
  </div>
{%- endunless -%}

{% stylesheet %}
  .cb-ship-progress {
    padding: 12px 16px;
    background: rgb(var(--color-foreground-rgb) / 0.04);
    border-radius: 8px;
    margin: 0 var(--cart-drawer-padding, 16px) 12px;
    font-size: 0.8125rem;
  }
  .cb-ship-progress__label {
    margin: 0 0 8px;
    line-height: 1.3;
  }
  .cb-ship-progress__label strong {
    font-weight: 600;
  }
  .cb-ship-progress__track {
    height: 6px;
    background: rgb(var(--color-foreground-rgb) / 0.12);
    border-radius: 999px;
    overflow: hidden;
  }
  .cb-ship-progress__fill {
    height: 100%;
    background: var(--color-foreground);
    border-radius: 999px;
    transition: width 300ms ease;
  }
{% endstylesheet %}
